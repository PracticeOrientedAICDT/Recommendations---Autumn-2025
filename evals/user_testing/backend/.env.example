# OpenAI API Key (required for embeddings and GPT recommendations)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (required for Claude recommendations)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database_name
# Example for local: postgresql://postgres:password@localhost:5432/movie_experiment
# Example for production: postgresql://user:pass@your-db-host.com:5432/movie_experiment
DATABASE_URL=postgresql://postgres:password@localhost:5432/movie_experiment

# Resend Email Configuration (for automatic email backups)
# Uses HTTPS - works everywhere including Render (never blocked)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev
BACKUP_EMAIL_RECIPIENT=guodala@gmail.com
